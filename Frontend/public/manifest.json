{
  "manifest_version": 3,
  "name": "GitHub Talent Analyzer",
  "version": "1.0.1",

  "permissions": [
    "sidePanel",
    "tabs"
  ],

  "host_permissions": [
    "https://github.com/*",
    "https://github-talent-analyzer-api.onrender.com/*"
  ],

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "background": {
    "service_worker": "background.js"
  },

  "action": {
  "default_title": "GitHub Talent Analyzer",
  "default_icon": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",  
    "128": "icons/icon128.png"
  }
},

  "side_panel": {
    "default_path": "index.html"
  }
}